<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">103</defaultcontrol>

    <!-- Window offset positioning -->
    <coordinates>
        <left>485</left>
        <top>345</top>
    </coordinates>

    <controls>
        <control type="group">

            <!-- Background panel -->
            <control type="image">
                <description>Background Image</description>
                <left>0</left>
                <top>0</top>
                <width>950</width>
                <height>500</height>
                <texture border="2">Background/ContentPanel.png</texture>
            </control>

            <!-- Inner frame border -->
            <control type="image">
                <description>Inner Border Image</description>
                <left>10</left>
                <top>10</top>
                <width>930</width>
                <height>570</height>
            </control>

            <!-- QR Code image control -->
            <control type="image" id="2001">
                <description>QR Code Image</description>
                <left>30</left>
                <top>120</top>
                <width>310</width>
                <height>310</height>
                <texture/>
                <aspectratio aligny="center" align="center">keep</aspectratio>
            </control>

            <!-- Dialog Header Label -->
            <control type="label" id="101">
                <description>Header Label</description>
                <left>360</left>
                <top>55</top>
                <width>530</width>
                <height>50</height>
                <font>font15</font>
                <textcolor>FFFFD700</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label/>
            </control>

            <!-- Main Message Label -->
            <control type="label" id="102">
                <description>Message Label</description>
                <left>360</left>
                <top>115</top>
                <width>530</width>
                <height>160</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <wrapmultiline>true</wrapmultiline>
                <label/>
            </control>

            <!-- URL Blue Box Background -->
            <control type="image">
                <description>URL Background</description>
                <left>380</left>
                <top>310</top>
                <width>490</width>
                <height>60</height>
                <texture colordiffuse="FF21262D">Background\white.png</texture>
            </control>

            <!-- URL Text Label (ID 104) -->
            <control type="label" id="104">
                <description>URL Text Label</description>
                <left>380</left>
                <top>310</top>
                <width>490</width>
                <height>60</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <aligny>center</aligny>
                <label/>
            </control>

            <!-- OK / Close Button -->
            <control type="button" id="103">
                <description>OK Button</description>
                <left>700</left>
                <top>440</top>
                <width>200</width>
                <height>45</height>
                <font>font13</font>
                <label>OK</label>
                <textcolor>FFCCCCCC</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <align>center</align>
                <aligny>center</aligny>
                <texturefocus border="5" colordiffuse="FF12B2E7">Button/scrollbar-V-focus.png</texturefocus>
                <texturenofocus/>
            </control>

        </control>
    </controls>
</window>