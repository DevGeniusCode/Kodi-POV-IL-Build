<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <!-- HIDDEN MARKERS: the shape to copy is
           <setting id="_something" type="string" label="30000">
             <level>4</level>
             <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
       Level 4 is SettingLevel::Internal and there is NO <control>. Both parts
       are load-bearing, and both were previously wrong in every marker here.

       * <control type="label" .../> does not exist for ADD-ON settings.
         AddonSettings.cpp registers exactly nine control types (toggle,
         spinner, edit, button, list, slider, range, title, colorbutton)
         and "label" is not among them; it is only registered for Kodi's own
         settings. CreateControl("label") therefore returned nullptr and
         Setting.cpp logged `error reading <control> tag of "<id>"` and
         DROPPED THE SETTING, 43 times, on every single startup.

       * visible="false" is read only by the version-0 parser
         (InitializeFromOldSettingDefinitions). This file is version="1", so
         the attribute was silently ignored and never hid anything.

       What actually hides them is level 4: Setting.cpp only demands a
       <control> when level < Internal, and GUIDialogSettingsBase::CreateControl
       returns NULL for a setting that has none, so no row is ever built. The
       values stay fully readable and writable through getSetting/setSetting,
       which is all these markers are for. -->
  <section id="kodipovilai">
    <!-- ========================= GENERAL ========================= -->
    <category id="general" label="32600">
      <!-- ~~~~~ Subtitle service ~~~~~ -->
      <group id="main">
        <!-- Master switch of the built-in sources engine (the Wizard reads this id). When on,
             MoranSubs searches the human subtitle sources itself through the engine in
             resources/lib/subs_engine. -->
        <setting id="use_builtin_engine" type="boolean" label="32508" help="32509">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="engine_autosub" type="boolean" label="32526" help="32527">
          <level>0</level>
          <default>true</default>
          <dependencies>
            <dependency type="visible" setting="use_builtin_engine" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <!-- 0.3.74: what the automatic subtitle does when there is no Hebrew
             at all (embedded, human or pooled): translate with AI (as before),
             ask each time, or leave it to a pick from the list. -->
        <setting id="ai_when_no_hebrew" type="string" label="32610" help="32611">
          <level>0</level>
          <default>auto</default>
          <constraints>
            <options>
              <option label="32612">auto</option>
              <option label="32613">ask</option>
              <option label="32614">manual</option>
            </options>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <and>
                <condition setting="use_builtin_engine" operator="is">true</condition>
                <condition setting="engine_autosub" operator="is">true</condition>
              </and>
            </dependency>
          </dependencies>
          <control type="list" format="string">
            <heading>32610</heading>
          </control>
        </setting>
        <setting id="autosub_excluded_addons" type="string" label="32548" help="32549"> <!-- Addons excluded from autosub -->
          <level>0</level>
          <default>plugin.video.idanplus</default>
          <dependencies>
            <dependency type="visible" setting="engine_autosub" operator="is">true</dependency>
          </dependencies>
          <control type="edit" format="string">
            <heading>32548</heading>
          </control>
        </setting>
        <!-- Step 8: the autosub "fast lane". When Ktuvit or Wizdom answers with a strong match
             (at least 90 and at least autosub_min_match_pct) the subtitle is applied at once,
             without waiting for the slower sources; the timing check runs in the background
             and one better match may replace it when the full search ends. -->
        <setting id="autosub_fast_apply" type="boolean" label="32652" help="32653">
          <level>0</level>
          <default>true</default>
          <dependencies>
            <dependency type="visible" setting="engine_autosub" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <!-- Step 8: the lowest match number autosub may pick (0 = no limit, the old behaviour). -->
        <setting id="autosub_min_match_pct" type="integer" label="32654" help="32655">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>100</maximum>
          </constraints>
          <dependencies>
            <dependency type="visible" setting="engine_autosub" operator="is">true</dependency>
          </dependencies>
          <control type="slider" format="integer">
            <popup>true</popup>
          </control>
        </setting>
        <setting id="subs_notifications" type="boolean" label="32542" help="32543"> <!-- Show subtitle/translation notifications -->
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

