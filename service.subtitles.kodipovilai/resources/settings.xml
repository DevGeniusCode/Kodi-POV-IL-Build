      <!-- ~~~~~ Hidden engine settings (level 4) ~~~~~ -->
      <!-- Hidden engine settings. The vendored engine reads these by name
           (Addon.getSetting). They MUST exist with safe defaults or the
           engine crashes on int('') / empty reads at import time. Not
           surfaced to users; the bridge seeds them (subs_engine_bridge.ensure_engine_settings)
           and MoranSubs controls translation centrally via translation_mode.
           All of these use the hidden-marker pattern documented at the top of
           this file: type="string" + <level>4</level> + NO <control>.
           Booleans are stored as the strings "true"/"false" (the engine
           reads them with getSetting(...)=='true', which works either way). -->
      <group id="engine_internal">
        <setting id="language_hebrew" type="string" label="30000">
          <level>4</level><default>true</default>
        </setting>
        <setting id="language_english" type="string" label="30000">
          <level>4</level><default>true</default>
        </setting>
        <setting id="enable_autosub_notifications" type="string" label="30000">
          <level>4</level><default>true</default>
        </setting>
        <setting id="auto_fix_sub_punctuation" type="string" label="30000">
          <level>4</level><default>true</default>
        </setting>
        <setting id="_engine_defaults_v" type="string" label="30000">
          <level>4</level><default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
