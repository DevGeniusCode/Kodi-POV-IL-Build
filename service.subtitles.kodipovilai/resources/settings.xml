      <!-- ~~~~~ Gender accuracy ~~~~~ -->
      <group id="gender" label="32605">
        <setting id="gender_ref_arabic" type="boolean" label="32546" help="32547"> <!-- Arabic gender reference -->
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="gender_proofread" type="boolean" label="32556" help="32557"> <!-- gender proofread by a stronger model -->
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="embedded_reference" type="boolean" label="32640" help="32650"> <!-- Read the file's own foreign track as a gender reference -->
          <level>3</level>
          <default>true</default>
