      <!-- ~~~~~ Performance ~~~~~ -->
      <group id="perf" label="32606">
        <setting id="whole_subtitle_request" type="boolean"
                 label="32411" help="32412"> <!-- Send whole subtitle in one Gemini request -->
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="chunk_lines" type="integer" label="32402"> <!-- Lines per translation request -->
          <level>0</level>
          <dependencies>
            <dependency type="enable" setting="whole_subtitle_request" operator="is">false</dependency>
          </dependencies>
          <default>50</default>
          <constraints>
            <minimum>30</minimum>
            <maximum>250</maximum>
            <step>10</step>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
          </control>
        </setting>
        <setting id="parallel_chunks" type="integer" label="32404"> <!-- Concurrent translation requests -->
          <level>0</level>
          <dependencies>
            <dependency type="enable" setting="whole_subtitle_request" operator="is">false</dependency>
          </dependencies>
          <default>3</default>
          <!-- max 16 so paid-tier "fast mode" (ai_paid_mode) can tune 8..16; the
               free path still caps itself at 8 in translate.py regardless. -->
          <constraints>
            <minimum>1</minimum>
            <maximum>16</maximum>
            <step>1</step>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
          </control>
        </setting>
        <setting id="fast_first_chunk" type="boolean"
                 label="32405" help="32406"> <!-- Fast subtitles -->
          <level>0</level>
          <dependencies>
            <dependency type="enable" setting="whole_subtitle_request" operator="is">false</dependency>
          </dependencies>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="prev_context_lines" type="integer" label="32624">
          <level>3</level>
          <default>5</default>
          <constraints>
            <minimum>0</minimum>
          </constraints>
          <control type="edit" format="integer">
            <heading>32624</heading>
          </control>
        </setting>
        <setting id="gemini_rpm" type="integer" label="32627" help="32628">
          <level>3</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
          </constraints>
          <control type="edit" format="integer">
            <heading>32627</heading>
          </control>
        </setting>
      </group>

      <!-- ~~~~~ Sampling and thinking ~~~~~ -->
      <group id="sampling" label="32607">
        <setting id="temperature" type="number" label="32403" help="32235"> <!-- Model temperature -->
          <level>0</level>
          <!-- SAMPLING KNOBS: SHOWN ONLY WHERE THEY DO SOMETHING.
               Google's Gemini docs: "temperature, top_p, and top_k are
               deprecated and ignored. In future model generations, supplying
               these parameters returns an HTTP 400 error." So from 3.5 up the
               add-on stops sending them (gemini.sampling_params_supported)
               and a slider here would be a control that changes nothing.
               This is a WHITELIST of the models that still honour them, not a
               blacklist of the ones that do not: add a newer model to the
               picker above and forget this list, and the slider correctly
               stays hidden, which is the way round that cannot mislead.
               tools/test_gemini_sampling_params.py fails if this list and the
               code's rule ever disagree, so they cannot drift apart. -->
          <dependencies>
            <dependency type="visible">
              <or>
                <condition setting="model" operator="is">gemini-3.1-flash</condition>
                <condition setting="model" operator="is">gemini-2.5-flash-lite</condition>
                <condition setting="model" operator="is">gemini-2.5-flash</condition>
              </or>
            </dependency>
          </dependencies>
          <default>1.0</default>
          <constraints>
            <minimum>0.0</minimum>
            <maximum>1.0</maximum>
            <step>0.01</step>
          </constraints>
          <control type="slider" format="number">
            <popup>true</popup>
          </control>
        </setting>
        <setting id="top_p" type="number" label="32407" help="32408"> <!-- Model Top-P -->
          <level>0</level>
          <!-- SAMPLING KNOBS: SHOWN ONLY WHERE THEY DO SOMETHING.
               Google's Gemini docs: "temperature, top_p, and top_k are
               deprecated and ignored. In future model generations, supplying
               these parameters returns an HTTP 400 error." So from 3.5 up the
               add-on stops sending them (gemini.sampling_params_supported)
               and a slider here would be a control that changes nothing.
               This is a WHITELIST of the models that still honour them, not a
               blacklist of the ones that do not: add a newer model to the
               picker above and forget this list, and the slider correctly
               stays hidden, which is the way round that cannot mislead.
               tools/test_gemini_sampling_params.py fails if this list and the
               code's rule ever disagree, so they cannot drift apart. -->
          <dependencies>
            <dependency type="visible">
              <or>
                <condition setting="model" operator="is">gemini-3.1-flash</condition>
                <condition setting="model" operator="is">gemini-2.5-flash-lite</condition>
                <condition setting="model" operator="is">gemini-2.5-flash</condition>
              </or>
            </dependency>
          </dependencies>
          <default>0.95</default>
          <constraints>
            <minimum>0.0</minimum>
            <maximum>1.0</maximum>
            <step>0.01</step>
          </constraints>
          <control type="slider" format="number">
            <popup>true</popup>
          </control>
        </setting>
        <setting id="thinking_budget" type="string" label="32409" help="32410"> <!-- Gemini thinking level / budget -->
          <level>0</level>
          <default>medium</default>
          <constraints>
            <options>
              <option label="32414">0</option>
              <option label="32415">minimal</option>
              <option label="32416">low</option>
              <option label="32417">medium</option>
              <option label="32418">high</option>
              <option label="32419">512</option>
              <option label="32420">768</option>
              <option label="32421">1024</option>
              <option label="32422">2048</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32409</heading>
          </control>
        </setting>
      </group>

      <!-- ~~~~~ TMDB notice ~~~~~ -->
      <group id="tmdb_notice" label="32260">
        <setting id="info_tmdb_notice" type="action" label="32261"> <!-- Static notice text + open services screen -->
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="action">
            <heading>32261</heading>
          </control>
          <data>RunScript(service.subtitles.kodipovilai,action=open_tmdb_notice)</data>
        </setting>
      </group>
    </category>

    <!-- ========================= SYNC ENGINE ========================= -->
    <category id="sync" label="32604">
      <!-- ~~~~~ Sync engine ~~~~~ -->
      <group id="sync_main">
        <setting id="subsync_verify" type="boolean" label="32620">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="subsync_probe" type="boolean" label="32621">
          <level>1</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable" setting="subsync_verify" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <setting id="subsync_audio" type="boolean" label="32622">
          <level>2</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable" setting="subsync_verify" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
        <setting id="subsync_autorank" type="boolean" label="32623">
          <level>2</level>
          <default>true</default>
          <dependencies>
            <dependency type="enable" setting="subsync_verify" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <!-- ========================= COMMUNITY POOL ========================= -->
    <category id="pool" label="32500">
      <!-- ~~~~~ Pool ~~~~~ -->
      <group id="1">
        <setting id="pool_use" type="boolean" label="32501"> <!-- Use community pool -->
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="pool_share" type="boolean" label="32502"> <!-- Share my AI translations -->
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="pool_share_cache" type="action" label="32503"> <!-- Share my cached translations now -->
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="action">
            <heading>32503</heading>
          </control>
          <data>RunScript(service.subtitles.kodipovilai,action=pool_share_cache)</data>
        </setting>
        <setting id="he_embedded_report" type="boolean" label="32626">
          <level>2</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <!-- ========================= CACHE ========================= -->
    <category id="cache" label="32300">
      <!-- ~~~~~ Cache limits ~~~~~ -->
      <group id="limits">
        <setting id="cache_size_mb" type="integer" label="32301"> <!-- Max cache size (MB) -->
          <level>0</level>
          <default>200</default>
          <constraints>
            <minimum>10</minimum>
            <maximum>2000</maximum>
            <step>10</step>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
            <formatlabel>32302</formatlabel> <!-- {} MB -->
          </control>
        </setting>
        <setting id="cache_ttl_days" type="integer" label="32303"> <!-- Auto-delete after N days no access -->
          <level>0</level>
          <default>180</default>
          <constraints>
            <minimum>7</minimum>
            <maximum>730</maximum>
            <step>1</step>
          </constraints>
          <control type="slider" format="integer">
            <popup>true</popup>
            <formatlabel>32304</formatlabel> <!-- {} days -->
          </control>
        </setting>
        <setting id="subtitle_trans_cache" type="integer" label="32629" help="32648"> <!-- Downloaded subtitle files kept in the cache -->
          <level>2</level>
          <default>200</default>
          <constraints>
            <minimum>1</minimum>
            <step>1</step>
            <maximum>1000</maximum>
          </constraints>
          <dependencies>
            <dependency type="visible" setting="use_builtin_engine" operator="is">true</dependency>
          </dependencies>
          <control type="edit" format="integer">
            <heading>32629</heading>
          </control>
        </setting>
        <!-- Both action buttons need an explicit <control type="button"
             format="action"> block. Without it some Kodi 21 builds
             silently drop action settings even when label + data are
             present. The other action buttons in this file (info_key
             etc.) also get this treatment for consistency. -->
        <setting id="clear_cache" type="action" label="32305"> <!-- Clear cache now -->
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="action">
            <heading>32305</heading>
          </control>
          <data>RunScript(service.subtitles.kodipovilai,action=clear_cache)</data>
        </setting>
        <setting id="purge_temp" type="action" label="32306"> <!-- Clear Kodi temp subtitle files -->
          <level>0</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="button" format="action">
            <heading>32306</heading>
          </control>
          <data>RunScript(service.subtitles.kodipovilai,action=purge_temp)</data>
        </setting>
      </group>
    </category>

    <!-- ========================= ADVANCED & DEBUG ========================= -->
    <category id="advanced" label="32400">
      <!-- ~~~~~ Logging and POV ~~~~~ -->
      <group id="debug">
        <setting id="log_level" type="string" label="32401"> <!-- Log level -->
          <level>1</level>
          <default>INFO</default>
          <constraints>
            <options>
              <option>DEBUG</option>
              <option>INFO</option>
              <option>WARNING</option>
              <option>ERROR</option>
            </options>
          </constraints>
          <control type="list" format="string">
            <heading>32401</heading>
          </control>
        </setting>
        <setting id="show_debug" type="boolean" label="32641" help="32651"> <!-- Engine debug lines in the Kodi log -->
          <level>3</level>
          <default>false</default>
          <dependencies>
            <dependency type="visible" setting="use_builtin_engine" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
      </group>

      <!-- ~~~~~ Markers and hidden state (level 4) ~~~~~ -->
      <!-- One-shot migration markers and hidden counters, declared so the next reader finds them
           all in one place (and because set_setting on an undeclared id silently no-ops).
           Each holds a short string ('1', or a comma separated list of the keys it has
           settled), which is why they are plain strings with an empty default.
           (No double hyphen anywhere in a comment here: XML forbids it.) -->
      <group id="markers">
        <!-- Hidden marker: the standalone add-on seeded Kodi's subtitle
             languages with Hebrew once (service._maybe_seed_hebrew_subtitle_prefs).
             The 0.2.x standalone wrote it undeclared and Kodi kept it anyway;
             declared here as house style. -->
        <setting id="_he_subs_prefs_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: which CACHE_RTL_FIX_VERSION has run. -->
        <setting id="_rtl_fix_done" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: community pool default-on migration has run. -->
        <setting id="_pool_default_on_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: Arabic gender-reference force-on migration has run. -->
        <setting id="_gender_ref_on_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: Gemini model bump (3.1->3.5 flash-lite, 3.5/3.6->3.7 flash) has run. -->
        <setting id="_gemini_model_bump_v2" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: Gemini model bump (3.7 flash -> 3.8 flash) has run.
             A NEW id per bump, never a reused one: v2 is already '1' on every
             device that took the previous bump, so reusing it would no-op this
             migration for exactly the users who need it. -->
        <setting id="_gemini_model_bump_v3" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: a stored gemini-3.1-flash (no such model at
             Google any more) was moved to the default model (0.3.78). -->
        <setting id="_gemini_model_bump_v4" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden marker: Gemini 3 temp/thinking tuning migration has run. -->
        <setting id="_gemini3_tune_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <setting id="_builtin_engine_rollout_v2" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <setting id="_chunk_lines_50_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <setting id="_fast_first_chunk_default_v2" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <setting id="_pool_share_force_v1" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden one-shot migration marker for embedded_translation_mode. -->
        <setting id="_embedded_mode_v1" type="string" label="30000">
          <level>4</level>
          <visible>false</visible>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden: anonymous per-install id for usage telemetry. -->
        <setting id="_telemetry_id" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden: daily Gemini Flash Lite request counter. Reset
             at UTC midnight by gemini_quota.note_request. -->
        <setting id="_usage_count" type="string" label="30000">
          <level>4</level>
          <default>0</default>
        </setting>
        <!-- Hidden: UTC date (YYYY-MM-DD) of the counter above. -->
        <setting id="_usage_date_utc" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden: model id the counter above belongs to, so the
             daily count is scoped per-model (Flash-Lite 500/day vs
             regular Flash 20/day) and resets on a model switch.
             MUST be declared or set_setting silently no-ops. -->
        <setting id="_usage_model" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden: "<Pacific day> <model>" when Google said that model's
             daily quota is used up (gemini_quota.note_exhausted). A Google
             fallback cached that day is not re-translated until the next
             day. MUST be declared or set_setting silently no-ops. -->
        <setting id="_gemini_quota_exhausted" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden state of the gender proofread (gender_proofread.note_exhausted):
             the day and the models whose daily quota ran out, so a second
             proofread that day does not spend a request on a model that has
             none left. It was written without a declaration, so set_setting
             silently no-opped and the stamp never persisted. -->
        <setting id="_proofread_quota_exhausted" type="string" label="30000">
          <level>4</level>
          <default></default>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
        </setting>
        <!-- Hidden legacy compatibility flag. The user-facing control is now
             embedded_translation_mode in Advanced. Keep this declared so an
             older settings profile remains readable during fallback. -->
        <setting id="embedded_translate" type="boolean" label="30000">
          <level>4</level>
          <visible>false</visible>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <!-- Hidden legacy compatibility flag. See embedded_translation_mode. -->
        <setting id="embedded_http_extract" type="boolean" label="30000">
          <level>4</level>
          <visible>false</visible>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <!-- 0.3.74: hidden; "AI translation when there is no Hebrew" (ai_when_no_hebrew)
             is the user's choice now. Kept for the old behaviour in "auto". -->
        <setting id="engine_force_translate" type="boolean" label="32531" help="32532">
          <level>4</level>
          <default>false</default>
          <dependencies>
            <dependency type="visible" setting="use_builtin_engine" operator="is">true</dependency>
          </dependencies>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
