msgid "Sync engine"
msgstr "סנכרון"

# Groups (reorganized settings screen)
msgctxt "#32605"
msgid "Gender accuracy"
msgstr "דיוק מגדר"

msgctxt "#32606"
msgid "Performance"
msgstr "ביצועים"

msgctxt "#32607"
msgid "Sampling and thinking"
msgstr "דגימה וחשיבה"

msgctxt "#32608"
msgid "Diagnostics"
msgstr "אבחון"

msgctxt "#32609"
msgid "Search"
msgstr "חיפוש"

msgctxt "#32610"
msgid "AI translation when there is no Hebrew"
msgstr "תרגום AI כשאין כתובית עברית"

msgctxt "#32611"
msgid "When a video starts and no Hebrew subtitle is found (embedded, human or from the community pool): translate with AI automatically, ask each time, or only when you pick a translation from the subtitle list yourself. A Hebrew subtitle that exists is always chosen automatically."
msgstr "כשסרטון מתחיל ולא נמצאה כתובית עברית (מובנית, אנושית או מהמאגר הקהילתי): לתרגם ב-AI אוטומטית, לשאול בכל פעם, או רק כשבוחרים תרגום בעצמך מרשימת הכתוביות. כתובית עברית שכבר קיימת נבחרת תמיד אוטומטית."

msgctxt "#32612"
msgid "Automatically"
msgstr "אוטומטית"

msgctxt "#32613"
msgid "Ask each time"
msgstr "לשאול בכל פעם"

msgctxt "#32614"
msgid "Only when I pick it from the list"
msgstr "רק כשאני בוחר מהרשימה"

# Sync engine settings (declared; the code already read them)
msgctxt "#32620"
msgid "Verify and fix subtitle timing"
msgstr "אימות ותיקון סנכרון הכתוביות"

msgctxt "#32621"
msgid "Read timing from the playing file"
msgstr "קריאת תזמון מהקובץ המתנגן"

msgctxt "#32622"
msgid "AI audio probe (uses Gemini quota)"
msgstr "בדיקת אודיו באמצעות AI (צורכת מכסת Gemini)"

msgctxt "#32623"
msgid "Automatic choice prefers verified timing"
msgstr "בחירה אוטומטית מעדיפה תזמון מאומת"

# Other declared settings
msgctxt "#32624"
msgid "Previous lines sent as context"
msgstr "שורות קודמות המשמשות כהקשר"

msgctxt "#32627"
msgid "Gemini requests per minute"
msgstr "בקשות Gemini לדקה"

msgctxt "#32628"
msgid "0 = automatic: a free key follows the model's free limit, a paid key is not paced. A lower number slows requests down; on a free key a higher number is capped to the model's limit."
msgstr "0 = אוטומטי: מפתח חינמי פועל לפי המגבלה החינמית של המודל, מפתח בתשלום לא מוגבל בקצב. מספר נמוך יותר מאט את הבקשות; במפתח חינמי מספר גבוה יותר מוגבל למגבלת המודל."

msgctxt "#32615"
msgid "Search also in Russian"
msgstr "חיפוש גם ברוסית"

msgctxt "#32643"
msgid "Adds Russian to the languages the built-in sources look for. Not used while \"Search in all languages\" is on."
msgstr "מוסיף רוסית לשפות שהמקורות המובנים מחפשים. לא בשימוש כשהאפשרות \"חיפוש בכל השפות\" פעילה."

msgctxt "#32616"
msgid "Search also in Arabic"
msgstr "חיפוש גם בערבית"

msgctxt "#32644"
msgid "Adds Arabic to the languages the built-in sources look for. Not used while \"Search in all languages\" is on."
msgstr "מוסיף ערבית לשפות שהמקורות המובנים מחפשים. לא בשימוש כשהאפשרות \"חיפוש בכל השפות\" פעילה."

msgctxt "#32617"
msgid "Other search languages"
msgstr "שפות חיפוש נוספות"

msgctxt "#32645"
msgid "Three-letter language codes separated by commas, for example fre,spa,ita. Added to the languages above. Not used while \"Search in all languages\" is on."
msgstr "קודי שפה בני 3 אותיות, מופרדים בפסיקים, למשל fre,spa,ita. מתווספים לשפות שלמעלה. לא בשימוש כשהאפשרות \"חיפוש בכל השפות\" פעילה."

msgctxt "#32618"
msgid "Search in all languages"
msgstr "חיפוש בכל השפות"

msgctxt "#32646"
msgid "The sources return subtitles in every language, not only Hebrew and English. Turn off to search only the languages selected here."
msgstr "המקורות מחזירים כתוביות בכל השפות, לא רק עברית ואנגלית. כבו כדי לחפש רק בשפות שנבחרו כאן."

msgctxt "#32619"
msgid "Retry in all languages when nothing is found"
msgstr "ניסיון חוזר בכל השפות כשלא נמצא דבר"

msgctxt "#32647"
msgid "When the search finds nothing, search once more in all languages. Used only while \"Search in all languages\" is off."
msgstr "כשהחיפוש לא מוצא דבר, מחפש פעם נוספת בכל השפות. בשימוש רק כשהאפשרות \"חיפוש בכל השפות\" כבויה."

msgctxt "#32629"
msgid "Downloaded subtitle files kept in the cache"
msgstr "קבצי כתוביות שהורדו ונשמרים במטמון"

msgctxt "#32648"
msgid "When the number of cached downloaded subtitle files goes above this, the whole downloaded-subtitles cache is cleared."
msgstr "כשמספר קבצי הכתוביות שהורדו ונשמרו במטמון עובר את המספר הזה, כל מטמון הכתוביות שהורדו מתנקה."

msgctxt "#32639"
msgid "OpenSubtitles API key (optional)"
msgstr "מפתח API של OpenSubtitles (אופציונלי)"

msgctxt "#32649"
msgid "Your own OpenSubtitles API key. When set, it is used instead of the built-in keys. Leave empty to use the built-in keys. May need a Kodi restart to take effect."
msgstr "מפתח API אישי של OpenSubtitles. כשהוא מוגדר, הוא בשימוש במקום המפתחות המובנים. השאירו ריק כדי להשתמש במפתחות המובנים. ייתכן שיידרש הפעלה מחדש של Kodi."

msgctxt "#32640"
msgid "Read the file's own foreign track as a gender reference"
msgstr "קריאת כתובית זרה מתוך הקובץ כהפניה למגדר"

msgctxt "#32650"
msgid "When a translation is made from a subtitle track inside the video file, also read another foreign track of that file (Arabic is the reference) to get the speaker's gender right. Turn off to never read the file for a reference."
msgstr "כשהתרגום נעשה מכתובית שבתוך קובץ הווידאו, קורא גם כתובית זרה נוספת מאותו קובץ (ערבית היא ההפניה) כדי לקבוע נכון את מגדר הדובר. כבו כדי לא לקרוא את הקובץ לצורך הפניה."

msgctxt "#32641"
msgid "Engine debug lines in the Kodi log"
msgstr "שורות דיבאג של המנוע ביומן Kodi"

msgctxt "#32651"
msgid "Writes the search engine's detailed debug lines to the Kodi log as warnings. Leave off unless you are collecting a log."
msgstr "כותב את שורות הדיבאג המפורטות של מנוע החיפוש ליומן Kodi כאזהרות. השאירו כבוי אלא אם אוספים יומן."

msgctxt "#32642"
msgid "Search languages"
msgstr "שפות חיפוש"

msgctxt "#32625"
msgid "Badge may ask Ktuvit when nothing else has Hebrew"
msgstr "התג רשאי לשאול את Ktuvit כשאין עברית במקור אחר"

msgctxt "#32626"
msgid "Report built-in Hebrew tracks to the pool"
msgstr "דיווח על רצועות עברית מובנות למאגר"

msgctxt "#32630"
msgid "AI Hebrew (translated from {0})"
msgstr "עברית AI (מתורגם מ-{0})"

msgctxt "#32631"
msgid "Translating chunk {0}/{1}..."
msgstr "מתרגם chunk {0}/{1}..."

msgctxt "#32632"
msgid "No API key configured. Open Settings to add one."
msgstr "אין מפתח Gemini — חבר מפתח חינמי בהגדרות התוסף (חיבור Gemini) לתרגום AI איכותי באמת בעברית."

msgctxt "#32633"
msgid "Connection successful. Model: {0}"
msgstr "החיבור הצליח. מודל: {0}"

msgctxt "#32634"
msgid "Connection failed: {0}"
msgstr "החיבור נכשל: {0}"

msgctxt "#32635"
msgid "Daily quota exceeded. Try again after midnight Pacific time (about 10:00 in Israel)."
msgstr "הקווטה היומית מוצתה. נסה שוב אחרי חצות בשעון קליפורניה (בסביבות 10:00 בבוקר בישראל)."

msgctxt "#32636"
msgid "No source subtitles found in supported languages."
msgstr "לא נמצאו כתוביות בשפות הנתמכות."

msgctxt "#32637"
msgid "Cache cleared. {0} files removed."
msgstr "ה-cache נוקה. {0} קבצים נמחקו."

msgctxt "#32638"
msgid "Translation failed: {0}"
msgstr "התרגום נכשל: {0}"

msgctxt "#32230"
msgid "3.5 Flash Lite (recommended, 500/day)"
msgstr "3.5 Flash Lite (מומלץ, 500 ביום)"

msgctxt "#32231"
msgid "3.1 Flash (premium, 20/day free)"
msgstr "3.1 Flash (פרימיום, 20 ביום בחינם)"

msgctxt "#32232"
msgid "2.5 Flash Lite (fallback)"
msgstr "2.5 Flash Lite (fallback)"

msgctxt "#32233"
msgid "2.5 Flash (fallback)"
msgstr "2.5 Flash (fallback)"

msgctxt "#32234"
msgid "3.8 Flash (newest, 20/day free)"
msgstr "3.8 Flash (החדש ביותר, 20 ביום בחינם)"

msgctxt "#32235"
msgid "Only affects Gemini 2.5 and 3.1. Google deprecated this parameter from Gemini 3.5 on, so it is hidden and not sent for newer models."
msgstr "משפיע רק על Gemini 2.5 ו-3.1. גוגל ביטלה את הפרמטר הזה מ-Gemini 3.5 והלאה, ולכן במודלים חדשים יותר הוא מוסתר ולא נשלח."

msgctxt "#32260"
msgid "TMDB (for gender-aware translation)"
msgstr "TMDB (לתרגום מודע למגדר)"

msgctxt "#32261"
msgid "How to connect TMDB (required for gender-aware translation)"
msgstr "איך מחברים TMDB (נדרש לתרגום מודע למגדר)"

msgctxt "#32222"
msgid "RTL punctuation fix direction"
msgstr "כיוון תיקון ניקוד RTL"

msgctxt "#32223"
msgid "How to handle Hebrew right-to-left rendering. Default 'RTL base' wraps each Hebrew line in an explicit right-to-left embedding so the player's own BiDi places punctuation, numbers, English names and parentheses on the correct side -- the root-cause fix. If your player does not honour the marks, switch to 'Reverse', which only moves the end-of-sentence punctuation (the previous default). 'legacy' moves leading punct to the end. 'off' disables the post-processor entirely."
msgstr "איך לטפל ברינדור ימין-לשמאל בעברית. 'RTL base' (ברירת מחדל) עוטף כל שורה עברית בכיוון RTL מפורש, כך שה-BiDi של הנגן ממקם ניקוד, מספרים, שמות באנגלית וסוגריים בצד הנכון - תיקון-שורש. אם הנגן שלך לא מכבד את הסימנים, עבור ל-'Reverse' שמזיז רק את נקודת סוף-המשפט (ברירת המחדל הקודמת). 'legacy' מזיז ניקוד מוביל לסוף. 'off' מבטל לגמרי."

msgctxt "#32224"
msgid "Legacy (move punct to end - old default, usually wrong)"
msgstr "Legacy (להזיז לסוף - ברירת מחדל ישנה, לרוב לא נכון)"

msgctxt "#32225"
msgid "Reverse (move only end punctuation - use if RTL base looks wrong)"
msgstr "Reverse (מזיז רק ניקוד סוף - השתמש אם RTL base נראה שגוי)"

msgctxt "#32226"
msgid "Off (no punctuation processing)"
msgstr "Off (בלי תיקון ניקוד)"

msgctxt "#32227"
msgid "RTL base (default - fixes numbers/English/parentheses/period)"
msgstr "RTL base (ברירת מחדל - מתקן מספרים/אנגלית/סוגריים/נקודה)"

msgctxt "#32500"
msgid "Community pool"
msgstr "מאגר קהילתי"

msgctxt "#32501"
msgid "Use community pool (pull shared Hebrew AI subtitles)"
msgstr "השתמש במאגר הקהילתי (משיכת כתוביות עברית משותפות)"

msgctxt "#32502"
msgid "Share my AI translations to the community pool"
msgstr "שתף את תרגומי ה-AI שלי למאגר הקהילתי"

msgctxt "#32503"
msgid "Share my cached translations now (one-time)"
msgstr "שתף עכשיו את כל התרגומים שבמטמון (חד-פעמי)"

msgctxt "#32504"
msgid "Remember picked source (auto-play it next time)"
msgstr "זכור את המקור שנבחר (נגן אותו אוטומטית בפעם הבאה)"

msgctxt "#32505"
msgid "Check remembered sources (diagnostic)"
msgstr "בדוק מקורות שנשמרו (אבחון)"

msgctxt "#32506"
msgid "Show Hebrew-subtitle match % on each source"
msgstr "הצג אחוז התאמת כתוביות עברית לכל מקור"

msgctxt "#32508"
msgid "Use the built-in sources engine (experimental)"
msgstr "השתמש במנוע המקורות המובנה (ניסיוני)"

msgctxt "#32509"
msgid "When on, MoranSubs searches the human subtitle sources itself (Ktuvit, Wizdom, etc.) instead of relying on the separate DarkSubs add-on. Still in testing."
msgstr "כשמופעל, MoranSubs מחפש בעצמו את מקורות הכתוביות האנושיות (Ktuvit, Wizdom וכו') במקום להסתמך על תוסף DarkSubs נפרד. עדיין בבדיקות."

msgctxt "#32510"
msgid "Search sources"
msgstr "מקורות חיפוש"

