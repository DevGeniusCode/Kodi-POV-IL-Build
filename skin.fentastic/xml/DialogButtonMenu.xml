<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>50%</centertop>
			<height>420</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="420" />
				<param name="header_label" value="$LOCALIZE[31072]" />
				<param name="header_id" value="2" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<!-- KODI-POV-IL - Taller power menu list -->
		<left>0</left>
		<top>80</top>
		<width>600</width>
		<height>320</height>
		<onleft>9000</onleft>
		<onright>9000</onright>
		<onup>9000</onup>
		<ondown>9000</ondown>
		<orientation>vertical</orientation>
		<itemlayout height="70" width="600">
			<control type="label">
				<left>0</left>
				<textoffsetx>20</textoffsetx>
				<top>25</top>
				<width>600</width>
				<height>70</height>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>unfocused_text</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<right>0</right>
				<textoffsetx>20</textoffsetx>
				<top>25</top>
				<width>300</width>
				<height>70</height>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>unfocused_text</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</itemlayout>
		<focusedlayout height="70" width="600">
			<control type="image">
				<left>25</left>
				<top>25</top>
				<width>550</width>
				<height>70</height>
				<texture colordiffuse="button_focus">masks/focus.png</texture>
			</control>
			<control type="label">
				<left>0</left>
				<textoffsetx>20</textoffsetx>
				<top>25</top>
				<width>600</width>
				<height>70</height>
				<align>center</align>
				<aligny>center</aligny>
				<!-- KODI-RD-IL CHANGES -->
				<label>$INFO[ListItem.Label]</label>
				<textcolor>focused_text</textcolor>
			</control>
			<control type="label">
				<right>0</right>
				<textoffsetx>20</textoffsetx>
				<top>25</top>
				<width>300</width>
				<height>70</height>
				<align>center</align>
				<aligny>center</aligny>
				<textcolor>unfocused_text</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</focusedlayout>
				<content>
					<!-- Exit and maintenance only. Settings, accounts, player, POV cache and skin switching live in the Quick Settings
					     menu (Custom_1136_QuickSettings.xml). Kodi only auto-closes this menu for buttons, not list items, so every item
					     runs Dialog.Close(shutdownmenu,true) first. No OS power items on purpose: the platform handles them. -->
					<item>
						<!-- Exit Kodi (Wizard-native force close) -->
						<label>[B][COLOR blue]יציאה מקודי[/COLOR][/B]</label>
						<onclick>Dialog.Close(shutdownmenu,true)</onclick>
						<onclick>RunPlugin(plugin://plugin.program.kodipovilwizard/?action=force_close)</onclick>
						<visible>System.ShowExitButton</visible>
					</item>
					<item>
						<!-- Reload skin -->
						<label>[B][COLOR blue]רענון סקין[/COLOR][/B]</label>
						<onclick>Dialog.Close(shutdownmenu,true)</onclick>
						<onclick>ReloadSkin()</onclick>
					</item>
					<item>
						<!-- Toggle the debug log -->
						<label>[B][COLOR blue]הפעלת/כיבוי לוג דיבוג[/COLOR][/B]</label>
						<onclick>Dialog.Close(shutdownmenu,true)</onclick>
						<onclick>ToggleDebug</onclick>
					</item>
					<item>
						<!-- CoreELEC only - Reboot to Android TV -->
						<label>[B][COLOR blue]$LOCALIZE[700069][/COLOR][/B]</label>
						<onclick>Dialog.Close(shutdownmenu,true)</onclick>
						<onclick>System.ExecWait("/usr/sbin/rebootfromnand")</onclick>
						<onclick>Reset()</onclick>
						<visible>System.PathExist("/usr/sbin/rebootfromnand")</visible>
					</item>
				</content>
			</control>
		<include content="UpDownArrows">
			<param name="container_id" value="9000" />
			<param name="posx" value="276" />
			<param name="up_posy" value="-40" />
			<param name="down_posy" value="430" />
			</include>
		</control>
	</controls>
</window>
