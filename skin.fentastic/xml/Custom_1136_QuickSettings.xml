<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1136">
	<defaultcontrol>9000</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centerleft>50%</centerleft>
			<width>600</width>
			<centertop>60%</centertop>
			<height>700</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="600" />
				<param name="height" value="485" />
				<param name="header_label" value="[B]הגדרות מהירות[/B]" />
				<param name="header_id" value="" />
				<param name="diffusetexture" value="masks/dialog-bg-squareish.png" />
			</include>
			<control type="panel" id="9000">
				<include>ButtonMenuList</include>
				<content>
					<!-- Quick Settings, opened by the Home settings button (803). Every item that launches something closes this window
					     first; the change-player item only flips a value, so it stays open and shows the current player on the right. -->
					<item>
						<!-- Subtitles and Gemini -->
						<label>[COLOR blue][B]כתוביות ו-Gemini[/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>Addon.OpenSettings(service.subtitles.kodipovilai)</onclick>
					</item>
					<item>
						<!-- Connect accounts: Account Manager's main screen (its default.py with no action opens its settings). If it is not
						     installed the Wizard route installs it first. -->
						<label>[COLOR blue][B]חיבור חשבונות[/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick condition="System.HasAddon(script.module.acctmgr)">RunAddon(script.module.acctmgr)</onclick>
						<onclick condition="!System.HasAddon(script.module.acctmgr)">RunPlugin(plugin://plugin.program.kodipovilwizard/?mode=run_acctmgr)</onclick>
					</item>
					<include>changeplayer_osd</include>
					<item>
						<!-- POV settings -->
						<label>[COLOR blue][B]$LOCALIZE[700050][/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>Addon.OpenSettings(plugin.video.pov)</onclick>
					</item>
					<item>
						<!-- Clear POV cache -->
						<label>[COLOR blue][B]$LOCALIZE[700052][/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>RunPlugin(plugin://plugin.video.pov/?mode=clear_all_cache&amp;isFolder=false)</onclick>
					</item>
					<item>
						<!-- Skin settings -->
						<label>[COLOR blue][B]$LOCALIZE[700018][/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>ActivateWindow(SkinSettings.xml)</onclick>
					</item>
					<item>
						<!-- Switch skin (Wizard) -->
						<label>[COLOR blue][B]$LOCALIZE[700058][/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>PlayMedia(&quot;plugin://plugin.program.kodipovilwizard/?mode=install&amp;action=build_switch_skin&quot;)</onclick>
					</item>
					<item>
						<!-- All Kodi settings -->
						<label>[COLOR blue][B]כל הגדרות קודי[/B][/COLOR]</label>
						<onclick>Dialog.Close(1136,true)</onclick>
						<onclick>ActivateWindow(Settings)</onclick>
					</item>
				</content>
			</control>
			<include content="UpDownArrows">
				<param name="container_id" value="9000" />
				<param name="posx" value="276" />
				<param name="up_posy" value="-40" />
				<param name="down_posy" value="500" />
			</include>
		</control>
	</controls>
</window>